{
  "name": "@neuron/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "localnet:setup": "tsx scripts/localnet-setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "openapi": "tsx -e \"import('./src/lib/openapi.ts').then(m=>require('fs').writeFileSync('../../docs/openapi.json', JSON.stringify(m.openapi(),null,2)))\""
  },
  "dependencies": {
    "@neuron/engine": "1.0.0",
    "@neuron/solana": "1.0.0",
    "@neuron/viz": "1.0.0",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/web3.js": "1.99.0",
    "@tanstack/react-query": "5.104.1",
    "bs58": "6.0.0",
    "next": "15.5.27",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tweetnacl": "1.0.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "esbuild": "0.28.2",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
