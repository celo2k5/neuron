# ---- required ----
DATABASE_URL=postgres://neuron@127.0.0.1:5433/neuron
APP_DOMAIN=localhost:3000          # domain bound into wallet sign-in challenges
APP_URL=http://localhost:3000
# ---- chain ----
SOLANA_CLUSTER=localnet            # localnet | devnet | mainnet-beta (mainnet also needs ALLOW_MAINNET=yes)
SOLANA_RPC=http://127.0.0.1:8899
SOLANA_FINALITY=confirmed          # use finalized on devnet/mainnet
REGISTRY_PROGRAM_ID=               # deployed neuron_registry program id; blank disables commitments
NEURON_MINT=                       # existing $NEURON mint; never auto-created outside localnet; blank disables token features
TREASURY_OWNER=                    # owner of the treasury token account that receives credit payments
DEV_MINT_AUTHORITY_KEYPAIR=        # localnet only: enables the test-token faucet
# ---- pricing & quotas (integers; token amounts in base units) ----
CREDIT_PRICE_BASE_UNITS=1000000
FREE_EXPERIMENTS_PER_DAY=25
FREE_TRAINING_PER_DAY=3
FREE_TRAINING_MAX_EPOCHS=300
REGISTRATION_CREDITS=5
SESSION_TTL_HOURS=24
# ---- governance ----
GOV_PROPOSAL_THRESHOLD=100000000
GOV_QUORUM=1000000000
GOV_VOTING_PERIOD_SEC=259200
GOV_EXECUTION_DELAY_SEC=86400
# ---- storage / ops ----
ARTIFACT_DIR=.artifacts            # content-addressed artifact store (swap adapter for S3/GCS in production)
WORKER_CONCURRENCY=3
NEURON_LOG=info                    # info | silent
