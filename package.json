{
  "name": "neuron",
  "private": true,
  "version": "0.1.0",
  "description": "NEURON — collective neural computation on Solana",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "npm run test -w @neuron/engine && npm run test -w @neuron/web",
    "test:engine": "npm run test -w @neuron/engine",
    "typecheck": "npm run typecheck -w @neuron/engine && npm run typecheck -w @neuron/web",
    "lint": "npm run lint -w @neuron/web",
    "build": "npm run build -w @neuron/web",
    "dev": "npm run dev -w @neuron/web",
    "worker": "npm run worker -w @neuron/web",
    "db:migrate": "npm run db:migrate -w @neuron/web",
    "localnet": "bash infra/localnet.sh",
    "test:program": "bash programs/neuron_registry/test.sh",
    "test:e2e": "npm run test:e2e -w @neuron/web"
  }
}
